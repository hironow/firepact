{
  "$defs": {
    "Message": {
      "properties": {
        "author": {
          "title": "Author",
          "type": "string",
          "x-firestore-ref-target": "Profile",
          "x-firestore-type": "reference"
        },
        "authorProfile": {
          "$ref": "#/$defs/Profile"
        },
        "body": {
          "title": "Body",
          "type": "string",
          "x-firestore-presence-guaranteed": true
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string",
          "x-firestore-server-timestamp": true,
          "x-firestore-type": "timestamp"
        },
        "editedAt": {
          "format": "date-time",
          "title": "Editedat",
          "type": "string",
          "x-firestore-type": "timestamp"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MessageKind"
        },
        "location": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Location",
          "type": "array",
          "x-firestore-type": "geopoint"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/Reaction"
          },
          "title": "Reactions",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "thumbnail": {
          "format": "binary",
          "title": "Thumbnail",
          "type": "string",
          "x-firestore-type": "bytes"
        }
      },
      "required": [
        "id",
        "author",
        "authorProfile",
        "body",
        "createdAt",
        "editedAt",
        "kind",
        "location",
        "metadata",
        "reactions",
        "tags",
        "thumbnail"
      ],
      "title": "Message",
      "type": "object",
      "x-firestore-collection": "rooms/{roomId}/messages",
      "x-firestore-doc-id-field": "id"
    },
    "MessageKind": {
      "enum": [
        "text",
        "image",
        "system"
      ],
      "title": "MessageKind",
      "type": "string"
    },
    "Profile": {
      "properties": {
        "avatarUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Avatarurl"
        },
        "displayName": {
          "title": "Displayname",
          "type": "string"
        }
      },
      "required": [
        "displayName",
        "avatarUrl"
      ],
      "title": "Profile",
      "type": "object"
    },
    "Reaction": {
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "emoji": {
          "title": "Emoji",
          "type": "string"
        }
      },
      "required": [
        "emoji",
        "count"
      ],
      "title": "Reaction",
      "type": "object"
    }
  }
}
